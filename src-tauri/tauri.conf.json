{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boop2",
  "version": "0.3.9",
  "identifier": "com.chans.boop2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["scripts/*"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxNjE4QzFDNzhCQ0I0ODMKUldTRHRMeDRISXhoY2JWYU5US2xsdWlvcjM0aVlPMUdVTFA4bnA3Rm9CVXVGMXVTMEd0Zkc5bWIK",
      "endpoints": ["https://github.com/inchan/Boop2/releases/latest/download/latest.json"]
    }
  }
}
